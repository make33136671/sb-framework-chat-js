{
  "name": "@saiboniuma/chat-ui",
  "version": "0.1.1",
  "description": "Pluggable chat UI component library with Shadow DOM isolation",
  "type": "module",
  "license": "MIT",
  "author": "saibotianlong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/make33136671/sb-framework-chat-js.git",
    "directory": "packages/chat-ui"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": ["chat-ui", "realtime", "messaging", "customer-service", "shadow-dom"],
  "sideEffects": false,
  "main": "./dist/realtime-chat-ui.umd.cjs",
  "module": "./dist/realtime-chat-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/realtime-chat-ui.js",
      "require": "./dist/realtime-chat-ui.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@saiboniuma/realtime-core": "^0.1.0"
  },
  "devDependencies": {
    "typescript": "~5.6.3",
    "vite": "^6.2.0",
    "vite-plugin-dts": "^4.5.0"
  }
}
